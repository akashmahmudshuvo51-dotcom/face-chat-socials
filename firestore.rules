rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owns(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 60; }
    function isFriend(otherUid) {
      return exists(/databases/$(database)/documents/friendships/$(request.auth.uid < otherUid ? request.auth.uid + "_" + otherUid : otherUid + "_" + request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if owns(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.displayName)
        && request.resource.data.keys().hasOnly(['uid','displayName','email','bio','photoURL','createdAt']);
      allow update: if owns(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.displayName)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','bio','photoURL','updatedAt']);
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.authorName)
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 3000
        && request.resource.data.mediaURL is string
        && request.resource.data.mediaType in ['', 'image', 'video']
        && request.resource.data.likeCount == 0
        && request.resource.data.keys().hasOnly(['uid','authorName','authorPhoto','text','mediaURL','mediaType','createdAt','likeCount']);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && request.resource.data.likeCount is int
        && request.resource.data.likeCount >= 0
        && request.resource.data.likeCount <= 100000000;
      allow delete: if owns(resource.data.uid) || isAdmin();

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if owns(uid) && request.resource.data.uid == request.auth.uid;
        allow delete: if owns(uid);
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && validName(request.resource.data.authorName)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(['uid','authorName','text','createdAt']);
        allow update: if false;
        allow delete: if signedIn() && (owns(resource.data.uid) || isAdmin());
      }
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['fromUid','fromName','fromEmail','toUid','toName','toEmail','status','createdAt']);
      allow update: if signedIn()
        && resource.data.status == 'pending'
        && ((resource.data.toUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedAt']) && request.resource.data.status in ['accepted','rejected'])
        || (resource.data.fromUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'pending'));
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || isAdmin());
    }

    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] != request.resource.data.members[1]
        && request.resource.data.keys().hasOnly(['members','createdAt'])
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.members[0] + "_" + request.resource.data.members[1]));
      allow update: if false;
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && isFriend(request.resource.data.members[0] == request.auth.uid ? request.resource.data.members[1] : request.resource.data.members[0]);
      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt']);
      allow delete: if false;

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read: if signedIn() && request.auth.uid in parentChat().members;
        allow create: if signedIn()
          && request.auth.uid in parentChat().members
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.keys().hasOnly(['senderUid','text','createdAt']);
        allow update, delete: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.authorName)
        && request.resource.data.mediaURL is string
        && request.resource.data.mediaType in ['image','video']
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(25, 'h')
        && request.resource.data.keys().hasOnly(['uid','authorName','mediaURL','mediaType','createdAt','expiresAt']);
      allow update: if false;
      allow delete: if signedIn() && (owns(resource.data.uid) || isAdmin());
    }
  }
}
